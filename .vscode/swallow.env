# Read through python.envFile for Test Explorer runs. Relative to the
# workspace root, the default test working directory. Debug and task
# configurations set PYTHONPATH themselves.
PYTHONPATH=src
# Keep test temporaries on the owner's G: drive (AGENTS.md: never use C:).
# Where this directory does not exist, Python skips it and uses its default.
TEMP=G:\ProjectSwallow-data\tmp
TMP=G:\ProjectSwallow-data\tmp
